# Order and row jumps; an order entry naming a missing pattern.
monotone name=jumps file=monotone/jumps.mon hardware=2 from=memory
monotone_query name=jumps
play sound=jumps as=j
set h=j speed=4
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
