# Titles and comments; extra bytes after the last cell.
monotone name=long file=monotone/long_title.mon
monotone_query name=long
monotone name=trailing file=monotone/trailing.mon from=memory
monotone_query name=trailing

# Damaged songs fail and leave an empty, silent song.
monotone name=bad_magic_path file=monotone/bad_magic.mon from=path
monotone name=bad_magic_memory file=monotone/bad_magic.mon from=memory
monotone name=bad_magic_file file=monotone/bad_magic.mon from=file
