# Twelve tracks taking turns on three hardware channels, then on twelve.
monotone name=twelve file=monotone/twelve.mon hardware=3 waveform=3 from=file
filter name=low kind=biquad type=lowpass freq=2000 res=2
sound_filter sound=twelve slot=0 filter=low
play sound=twelve as=t pan=0.3
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
