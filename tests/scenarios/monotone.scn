# Monotone (milestone F unit 4): a song using every effect (arpeggios,
# slides up, down and to a note, the first from 0 Hz (reference patch
# 0075), vibrato, including on note 1 (patch 0073), notes past 99 (patch
# 0072), tempo changes and a row jump) played with tracks taking turns
# on one hardware channel, then on four, changed while playing; every
# waveform and one past the last; order and row jumps into a missing
# pattern (patch 0072); twelve tracks on three hardware channels, then
# twelve, and thirteen refused (patch 0071); a song without an end
# marker passing the order's last entry (patch 0072); titles cut at 40
# bytes (patch 0070); damaged songs from a path, memory and a DiskFile
# failing (patches 0068, 0069, 0071) and playing silence; a play speed
# below 60 Hz (patch 0074), seeks forward and back (NOT_IMPLEMENTED), a
# filter, and a 48 kHz engine.
init channels=2
monotone name=demo file=monotone/demo.mon
monotone_query name=demo
play sound=demo as=d
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
monotone_set name=demo hardware=4 waveform=2
monotone_query name=demo
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
set h=d seek=6
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
set h=d seek=10.5
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
set h=d seek=14
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
set h=d seek=1
query h=d
mix frames=4096
mix frames=4096
stop_all

# Every waveform, and an index without one (square).
monotone name=w0 file=monotone/demo.mon hardware=3 waveform=0 volume=0.5
play sound=w0 as=w0
mix frames=4096
mix frames=4096
stop_all
