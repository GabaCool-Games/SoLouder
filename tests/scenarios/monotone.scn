monotone_set name=twelve hardware=13
monotone_set name=twelve hardware=0
monotone_set name=twelve waveform=4294967295
monotone_query name=twelve
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
stop_all

# No end marker: the order starts again after its 256th entry.
