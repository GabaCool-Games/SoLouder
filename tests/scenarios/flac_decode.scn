# FLAC files decoded by SoLoud's Wav::load (dr_flac) and by solouder-decoders:
# 8, 12, 16, 20, 24, 28 and 32-bit samples, 1 to 8 channels, every subframe
# type and stereo decorrelation, both residual codings with escaped
# partitions, wasted bits, variable block sizes (also all of one size) and
# metadata blocks to skip;
# then a frame with a bad checksum, data cut short, an unknown or overstated
# length, a header cut short and a zero sample rate. dr_flac plays a frame
# with a bad checksum and pads short data to the declared length; SoLouder
# silences the frame and keeps only the frames present, so those samples are
# checked by the decoder's unit tests instead (docs/port-status.md).
init
load name=s16 file=flac/s16_stereo_44100.flac
samples name=s16
load name=s24 file=flac/s24_mono_48000.flac
samples name=s24
load name=s8 file=flac/s8_quad_8000.flac
samples name=s8
load name=s12 file=flac/s12_5.1_22050.flac
samples name=s12
load name=s20 file=flac/s20_stereo_96000_variable.flac
samples name=s20
load name=meta file=flac/s16_7.1_32000_metadata.flac
samples name=meta
load name=s32 file=flac/s32_mono_44100.flac
samples name=s32
load name=s28 file=flac/s28_stereo_44100.flac
samples name=s28
load name=equal file=flac/s16_mono_44100_variable_equal.flac
samples name=equal
load name=crc file=flac/bad_crc_s16_mono_44100.flac
load name=short file=flac/short_data_s16_mono_44100.flac
load name=unknown file=flac/unknown_length_s16_mono_44100.flac
load name=claim file=flac/long_claim_s16_mono_44100.flac
load name=cut file=flac/bad_cut_header.flac
load name=norate file=flac/bad_zero_rate.flac
