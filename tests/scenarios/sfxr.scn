# Parameter files.
sfxr name=laser file=sfxr/v102_laser.sfx volume=0.7
sfxr name=burst file=sfxr/v101_burst.sfx from=memory
sfxr name=sine file=sfxr/v100_sine.sfx from=file
sfxr name=saw file=sfxr/v102_saw.sfx
sfxr name=wave7 file=sfxr/v102_wave_7.sfx
sfxr name=flag file=sfxr/v102_filter_byte_2.sfx from=memory
sfxr name=trail file=sfxr/v101_trailing.sfx from=file
sfxr_query name=laser
sfxr_query name=burst
sfxr_query name=sine
sfxr_query name=saw
sfxr_query name=wave7
sfxr_query name=flag
sfxr_query name=trail
play sound=laser as=f_laser
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
query h=f_laser
stop_all
play sound=burst as=f_burst
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
query h=f_burst
stop_all
play sound=sine as=f_sine
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
query h=f_sine
stop_all
play sound=saw as=f_saw
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
query h=f_saw
stop_all
play sound=wave7 as=f_wave7
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
query h=f_wave7
stop_all
sfxr_load name=laser file=sfxr/bad_cut_102.sfx from=path
sfxr_load name=laser file=sfxr/bad_cut_102.sfx from=memory
sfxr_load name=laser file=sfxr/bad_cut_102.sfx from=file
sfxr_load name=laser file=sfxr/bad_cut_header.sfx from=path
sfxr_load name=laser file=sfxr/bad_cut_header.sfx from=memory
sfxr_load name=laser file=sfxr/bad_cut_header.sfx from=file
sfxr_load name=laser file=sfxr/bad_version_103.sfx from=path
sfxr_load name=laser file=sfxr/bad_version_103.sfx from=memory
sfxr_load name=laser file=sfxr/bad_version_103.sfx from=file
sfxr_load name=laser file=sfxr/bad_empty.sfx from=path
sfxr_load name=laser file=sfxr/bad_empty.sfx from=memory
sfxr_load name=laser file=sfxr/bad_empty.sfx from=file
sfxr_query name=laser
# Version 100 keeps the arpeggio and slide change already loaded.
sfxr_load name=laser file=sfxr/v100_sine.sfx
sfxr_query name=laser
play sound=laser as=kept
mix frames=4096
mix frames=4096
stop_all

# A voice keeps the settings it started with.
sfxr name=change preset=5 seed=9
play sound=change as=c1
mix frames=1000
sfxr_load name=change preset=0 seed=9
play sound=change as=c2 pan=0.5
mix frames=4096
sfxr_reset name=change
sfxr_query name=change
play sound=change as=c3 pan=-0.5
mix frames=4096
mix frames=4096
sound_query name=change
counts
stop_all

# Looping restarts inside the source; switching it off lets the sound end.
sfxr name=loop preset=6 seed=77 looping=1
play sound=loop as=l
mix frames=4096
mix frames=4096
mix frames=4096
query h=l
set h=l looping=0
mix frames=4096
mix frames=4096
query h=l
counts

# Speed, sample rate and seeks.
sfxr name=long preset=3 seed=5
play sound=long as=s
set h=s speed=1.3
mix frames=1500
set h=s seek=0.2
mix frames=900
set h=s seek=0.05
query h=s
set h=s rate=30000
mix frames=2000
stop_all

# A filter, two voices, a queue.
filter name=echo kind=echo delay=0.05 decay=0.5
sound_filter sound=laser slot=1 filter=echo
play sound=laser as=e1
play sound=laser as=e2 pan=-1 volume=0.5
mix frames=4096
mix frames=4096
stop_all
queue name=q rate=44100 channels=1
play sound=q as=qv
queue_add queue=q sound=p0_0
queue_add queue=q sound=burst
queue_add queue=q sound=loop
mix frames=4096
set h=qv seek=0.3
mix frames=4096
mix frames=4096
queue_query queue=q

init channels=2 rate=48000 buffer=6000
sfxr name=x preset=2 seed=31
play sound=x as=x
mix frames=4096
set h=x seek=0.3
mix frames=4096
mix frames=4096
