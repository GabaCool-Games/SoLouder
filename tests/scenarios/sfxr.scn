# Sfxr (milestone F unit 3): every preset with several seeds, including
# seeds whose state arithmetic wraps (4294967295 is -1 and 2147483648 is
# INT_MIN as an int), each played to its end through the decaying tails
# of its filters; an unknown preset (INVALID_PARAMETER); parameter files of
# versions 100, 101 and 102 loaded from a path, from memory and through a
# DiskFile, a wave type without a waveform, a filter flag byte of 2
# (reference patch 0073), trailing bytes, and damaged files that fail
# without changing the settings (patch 0072), while version 100 keeps the
# previous arpeggio and slide change; settings changed after a play
# reaching only later voices; looping inside the source (also switched
# off while playing), seeking forward and back (NOT_IMPLEMENTED), a filter,
# a queue, and a 48 kHz engine.
init channels=2
sfxr name=p0_0 preset=0 seed=0
sfxr_query name=p0_0
play sound=p0_0 as=h_p0_0
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
query h=h_p0_0
stop_all
sfxr name=p0_12345 preset=0 seed=12345
sfxr_query name=p0_12345
play sound=p0_12345 as=h_p0_12345
mix frames=4096
mix frames=4096
mix frames=4096
mix frames=4096
query h=h_p0_12345
stop_all
