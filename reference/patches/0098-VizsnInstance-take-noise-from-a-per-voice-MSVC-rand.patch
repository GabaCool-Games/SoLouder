From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Sun, 18 Oct 2026 03:54:39 +0300
Subject: [PATCH] VizsnInstance: take noise from a per-voice MSVC rand()

VizsnInstance took its noise from the C runtime's rand(), which the process shares: each voice continued where the last left off, other sounds and code changed it, and glibc gave other noise than MSVC. Each voice now runs MSVC's rand() LCG of its own, seeded 1.
---
 include/soloud_vizsn.h                 |  3 +++
 src/audiosource/vizsn/soloud_vizsn.cpp | 18 ++++++++++++++----
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/include/soloud_vizsn.h b/include/soloud_vizsn.h
index 96e9b08..3b59ef7 100644
--- a/include/soloud_vizsn.h
+++ b/include/soloud_vizsn.h
@@ -67,6 +67,9 @@ namespace SoLoud
 		int mB;
 		int mOrgv;
 		float mGlotlast;
+		// MSVC's rand(), per voice (the CRT's is shared by the process).
+		unsigned int mRandState;
+		int nextRand();
 	};
 
 	class Vizsn : public AudioSource
diff --git a/src/audiosource/vizsn/soloud_vizsn.cpp b/src/audiosource/vizsn/soloud_vizsn.cpp
index bb3b756..5a3d7b8 100644
--- a/src/audiosource/vizsn/soloud_vizsn.cpp
+++ b/src/audiosource/vizsn/soloud_vizsn.cpp
@@ -225,6 +225,7 @@ namespace SoLoud
 		mNper = 0;
 		mNmod = 0;
 		mNopen = 0;
+		mRandState = 1;
 		memset(mBuf, 0, sizeof(float) * 2048);
 	}
 
@@ -323,22 +324,31 @@ namespace SoLoud
 		switch (aVoicetype)
 		{
 		case 0:	return (mA & (256 + 128 + 32)) * 5 * 0.0002f;
-		case 1:	return (float)(sin(mA * 0.0002) * cos(mA * 0.0003) * 0.2f + ((rand() % 200 - 100) / 300.0f)); // ilmava
+		case 1:	return (float)(sin(mA * 0.0002) * cos(mA * 0.0003) * 0.2f + ((nextRand() % 200 - 100) / 300.0f)); // ilmava
 		case 2: return (float)tan(mA*0.00002)*0.01f; // burpy
 		case 3: return ((mA & 65535) > 32768 ? 65535 : 0) * 0.00001f; // square wave
 		case 4: return (float)mA * (float)mA * 0.0000000002f; // kuisku
 		case 5:	mA += 3; mB++; return ((mA & 255) > ((mB >> 2) & 255)) ? 0.3f : 0.0f;
 		case 7:	return ((mA >> 8) & (256 + 128)) * 0.001f; // robottipulssi
-		case 8:	return (float)(rand() % (1 + ((mA & 65535) >> 8))) / 256; // -- hiukka ihmisempi tsaatana
-		case 9:	return ((float)(rand() & 32767)) / 32767; // -- noise: tsaatana
+		case 8:	return (float)(nextRand() % (1 + ((mA & 65535) >> 8))) / 256; // -- hiukka ihmisempi tsaatana
+		case 9:	return ((float)(nextRand() & 32767)) / 32767; // -- noise: tsaatana
 		case 6: // fallthrough
 		default: return (mA & 65535) * (0.001f / 256); /*-- sawtooth: near natural */
 		}
 	}
 
+	// MSVC's rand(), seeded 1 per voice: the C runtime's rand() is shared
+	// by the process, so each voice continued where the last left off, and
+	// other C runtimes gave other noise.
+	int VizsnInstance::nextRand()
+	{
+		mRandState = mRandState * 214013u + 2531011u;
+		return (int)((mRandState >> 16) & 0x7fff);
+	}
+
 	float VizsnInstance::noisrc()
 	{
-		return ((float)(rand() & 32767)) / 32768;
+		return ((float)(nextRand() & 32767)) / 32768;
 	}
 
 	float VizsnInstance::genwave()
