From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Sun, 18 Oct 2026 06:07:54 +0300
Subject: [PATCH] Ay::loadFile: refuse dumps of more than 131072 ops in two
 frames

ChipPlayer plays a frame's ops at once, and a frame takes ops until its
waits reach the frame's ticks, which a dump might never do: 33.5 million
writes ran in one frame, about 135 ms of work on the audio thread, again
at every restart of a looping voice. A dump is now refused if any stretch
of its ops before waits of two frames' ticks (a long wait carries a frame
up to twice its ticks), reading on from its start again as a looping
voice restarts (unless it never waits, when a restart plays nothing),
holds more than 131072 ops. A Z80 at 3.5 MHz writes at most about 28000
registers in those 0.19 s (two OUTs of 11 cycles or more each), and
ay2zak writes at most one wait between two writes, so no dump of a real
tune comes near; the check takes one pass over the ops.
---
 src/audiosource/ay/soloud_ay.cpp | 41 ++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/src/audiosource/ay/soloud_ay.cpp b/src/audiosource/ay/soloud_ay.cpp
index 9f495c9..7fe7fc9 100644
--- a/src/audiosource/ay/soloud_ay.cpp
+++ b/src/audiosource/ay/soloud_ay.cpp
@@ -132,6 +132,31 @@ namespace SoLoud
 		return res;
 	}
 
+	// The most ops in any stretch of the ops before waits of aWindow ticks:
+	// the ops are read from the start to the end, and again from the start
+	// if aRepeat, as a looping voice restarts. Counts up to aLimit + 1.
+	static unsigned int mostOpsBeforeWaits(const unsigned short *aOps, int aLength, bool aRepeat,
+		unsigned long long aWindow, unsigned int aLimit)
+	{
+		unsigned long long count = (aLength + 1) / 2;
+		unsigned long long end = aRepeat ? ~0ull : count;
+		unsigned long long i, j = 0, sum = 0;
+		unsigned int most = 0;
+		for (i = 0; i < count && most <= aLimit; i++)
+		{
+			while (j < end && sum < aWindow && j - i <= aLimit)
+			{
+				unsigned short op = aOps[j % count];
+				sum += (op & 0x8000) ? (op & 0x7fff) : 0;
+				j++;
+			}
+			if (j - i > most)
+				most = (unsigned int)(j - i);
+			sum -= (aOps[i] & 0x8000) ? (aOps[i] & 0x7fff) : 0;
+		}
+		return most;
+	}
+
 	result Ay::loadFile(File *aFile)
 	{
 		if (aFile == NULL)
@@ -211,6 +236,22 @@ namespace SoLoud
 				return FILE_LOAD_FAILED;
 			}
 		}
+		// ChipPlayer plays a frame's ops at once: a frame takes ops until
+		// its waits reach the frame's ticks, which a dump might never do, and
+		// a looping voice restarts within the frame. The ops before waits of
+		// two frames' ticks (a long wait carries a frame up to twice its
+		// ticks), counting restarts unless the dump never waits, may be at
+		// most 131072: a Z80 at 3.5 MHz writes at most about 28000 registers
+		// in those 0.19 s.
+		unsigned long long waits = 0;
+		for (int i = 0; i < (length + 1) / 2; i++)
+			waits += (ops[i] & 0x8000) ? (ops[i] & 0x7fff) : 0;
+		unsigned long long frame = (unsigned long long)(unsigned int)cpuspeed * (8192 - 20) / 44100 / 2;
+		if (mostOpsBeforeWaits(ops, length, waits > 0, 2 * frame, 131072) > 131072)
+		{
+			delete[] ops;
+			return FILE_LOAD_FAILED;
+		}
 		mOps = ops;
 		mLength = length;
 		mLooppos = looppos;
