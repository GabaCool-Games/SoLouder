From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Sun, 18 Oct 2026 02:22:20 +0300
Subject: [PATCH] Monotone: start with an empty song, and empty it when a load
 fails

The constructor left the song's version, pattern and track counts and
order uninitialised, and clear() kept them, so a song never loaded, or
one whose load failed after reading its track count, played its tracks
through a null pattern pointer. The constructor and clear() now empty
the song, and a failed version check clears what was read.
---
 src/audiosource/monotone/soloud_monotone.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/audiosource/monotone/soloud_monotone.cpp b/src/audiosource/monotone/soloud_monotone.cpp
index 79d78e3..6a9a655 100644
--- a/src/audiosource/monotone/soloud_monotone.cpp
+++ b/src/audiosource/monotone/soloud_monotone.cpp
@@ -314,6 +314,11 @@ namespace SoLoud
 		mSong.mTitle = 0;
 		mSong.mComment = 0;
 		mSong.mPatternData = 0;
+		mSong.mVersion = 0;
+		mSong.mTotalPatterns = 0;
+		mSong.mTotalTracks = 0;
+		mSong.mCellSize = 0;
+		memset(mSong.mOrder, 0, sizeof(mSong.mOrder));
 
 		mBaseSamplerate = 44100;
 		mChannels = 1;
@@ -333,6 +338,12 @@ namespace SoLoud
 		mSong.mTitle = 0;
 		mSong.mComment = 0;
 		mSong.mPatternData = 0;
+		// An empty song: no tracks, so voices are silent.
+		mSong.mVersion = 0;
+		mSong.mTotalPatterns = 0;
+		mSong.mTotalTracks = 0;
+		mSong.mCellSize = 0;
+		memset(mSong.mOrder, 0, sizeof(mSong.mOrder));
 	}
 
 	Monotone::~Monotone()
@@ -406,6 +417,7 @@ namespace SoLoud
 		mSong.mCellSize = temp[3];
 		if (mSong.mVersion != 1 || mSong.mCellSize != 2)
 		{
+			clear();
 			return FILE_LOAD_FAILED;
 		}
 		aFile->read(mSong.mOrder, 256);
