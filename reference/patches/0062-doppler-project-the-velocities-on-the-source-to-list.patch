From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Sun, 18 Oct 2026 01:25:01 +0300
Subject: [PATCH] doppler: project the velocities on the source-to-listener
 vector, as OpenAL 1.1 does

Approaching sources played lower and receding ones higher.
---
 src/core/soloud_core_3d.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/core/soloud_core_3d.cpp b/src/core/soloud_core_3d.cpp
index 6894428..4ce4b2d 100644
--- a/src/core/soloud_core_3d.cpp
+++ b/src/core/soloud_core_3d.cpp
@@ -140,8 +140,12 @@ namespace SoLoud
 #define MAX(a,b) ((a) > (b)) ? (a) : (b)
 #endif
 
+	// aDeltaPos is the source's position relative to the listener. OpenAL
+	// 1.1 projects the velocities on the source-to-listener vector, so a
+	// source approaching (or a listener receding) has a positive speed.
 	float doppler(vec3 aDeltaPos, const vec3 &aSrcVel, const vec3 &aDstVel, float aFactor, float aSoundSpeed)
 	{
+		aDeltaPos.neg();
 		float deltamag = aDeltaPos.mag();
 		if (deltamag == 0)
 			return 1.0f;
