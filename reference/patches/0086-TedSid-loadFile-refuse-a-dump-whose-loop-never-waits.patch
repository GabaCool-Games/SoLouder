From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Sun, 18 Oct 2026 02:41:08 +0300
Subject: [PATCH] TedSid::loadFile: refuse a dump whose loop never waits

TedSidInstance::tick reads ops until one waits, so a dump whose loop
holds no wait, or only waits of 0, spun forever on the audio thread.
Such dumps now fail with FILE_LOAD_FAILED.
---
 src/audiosource/tedsid/soloud_tedsid.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/audiosource/tedsid/soloud_tedsid.cpp b/src/audiosource/tedsid/soloud_tedsid.cpp
index 734bc79..1ef9e9c 100644
--- a/src/audiosource/tedsid/soloud_tedsid.cpp
+++ b/src/audiosource/tedsid/soloud_tedsid.cpp
@@ -229,6 +229,17 @@ namespace SoLoud
 			delete[] buf;
 		}
 
+		// tick() reads ops until a wait: the loop must wait somewhere, or it
+		// would spin forever.
+		bool waits = false;
+		for (int pos = looppos; pos < length && !waits; pos += 2)
+			waits = (ops[pos / 2] & 0x8000) && (ops[pos / 2] & 0x7fff);
+		if (!waits)
+		{
+			delete[] ops;
+			return FILE_LOAD_FAILED;
+		}
+
 		mOps = ops;
 		mLength = length;
 		mLooppos = looppos;
