From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Mon, 12 Oct 2026 18:10:56 +0300
Subject: [PATCH] LofiFilter: keep state for every channel

---
 include/soloud_lofifilter.h      |  2 +-
 src/filter/soloud_lofifilter.cpp | 10 ++++++----
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/include/soloud_lofifilter.h b/include/soloud_lofifilter.h
index be3d594..81c1087 100644
--- a/include/soloud_lofifilter.h
+++ b/include/soloud_lofifilter.h
@@ -45,7 +45,7 @@ namespace SoLoud
 			SAMPLERATE,
 			BITDEPTH
 		};
-		LofiChannelData mChannelData[2];
+		LofiChannelData mChannelData[MAX_CHANNELS];
 		
 		LofiFilter *mParent;
 	public:
diff --git a/src/filter/soloud_lofifilter.cpp b/src/filter/soloud_lofifilter.cpp
index e443697..9587268 100644
--- a/src/filter/soloud_lofifilter.cpp
+++ b/src/filter/soloud_lofifilter.cpp
@@ -36,10 +36,12 @@ namespace SoLoud
 		initParams(3);
 		mParam[SAMPLERATE] = aParent->mSampleRate;
 		mParam[BITDEPTH] = aParent->mBitdepth;
-		mChannelData[0].mSample = 0;
-		mChannelData[0].mSamplesToSkip = 0;
-		mChannelData[1].mSample = 0;
-		mChannelData[1].mSamplesToSkip = 0;
+		int i;
+		for (i = 0; i < MAX_CHANNELS; i++)
+		{
+			mChannelData[i].mSample = 0;
+			mChannelData[i].mSamplesToSkip = 0;
+		}
 	}
 
 	void LofiFilterInstance::filterChannel(float *aBuffer, unsigned int aSamples, float aSamplerate, double aTime, unsigned int aChannel, unsigned int /*aChannels*/)
