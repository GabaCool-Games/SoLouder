From: V <61495413+kelo221@users.noreply.github.com>
Date: Mon, 12 Oct 2026 18:47:44 +0300
Subject: [PATCH] FreeverbFilter: apply the settings the instance was created
 with

---
 src/filter/soloud_freeverbfilter.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/filter/soloud_freeverbfilter.cpp b/src/filter/soloud_freeverbfilter.cpp
index 9e3dfcd..e7f5958 100644
--- a/src/filter/soloud_freeverbfilter.cpp
+++ b/src/filter/soloud_freeverbfilter.cpp
@@ -473,6 +473,9 @@ namespace SoLoud
 		mParam[DAMP] = aParent->mDamp;
 		mParam[WIDTH] = aParent->mWidth;
 		mParam[WET] = 1;
+		// The model starts with its own defaults; apply the settings at the
+		// first filter call.
+		mParamChanged = (1 << 5) - 1;
 	}
 
 	void FreeverbFilterInstance::filter(float* aBuffer, unsigned int aSamples, unsigned int aBufferSize, unsigned int aChannels, float aSamplerate, time aTime)
