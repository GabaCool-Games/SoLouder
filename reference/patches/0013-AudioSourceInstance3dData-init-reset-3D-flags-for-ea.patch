From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Mon, 12 Oct 2026 12:02:52 +0300
Subject: [PATCH] AudioSourceInstance3dData::init: reset 3D flags for each new
 voice

init() did not touch mFlags, so a reused voice slot kept the previous
voice's 3D flags until update3dAudio copied the instance flags. play3d
computes the first attenuation before that, so a world-space voice in a
slot last used by a listener-relative voice started at the wrong volume
(1.0 instead of 1/99 at 99 units with inverse-distance attenuation).

Fixes upstream #361.
---
 src/core/soloud_audiosource.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/core/soloud_audiosource.cpp b/src/core/soloud_audiosource.cpp
index ea11a01..1421d64 100644
--- a/src/core/soloud_audiosource.cpp
+++ b/src/core/soloud_audiosource.cpp
@@ -63,6 +63,13 @@ namespace SoLoud
 		mAttenuator = aSource.mAttenuator;
 		m3dVolume = 1.0f;
 		mDopplerValue = 1.0f;
+		// The slot may be reused; don't keep the previous voice's flags until
+		// the next update3dAudio copies the instance flags.
+		mFlags = 0;
+		if (aSource.mFlags & AudioSource::LISTENER_RELATIVE)
+			mFlags |= AudioSourceInstance::LISTENER_RELATIVE;
+		if (aSource.mFlags & AudioSource::PROCESS_3D)
+			mFlags |= AudioSourceInstance::PROCESS_3D;
 	}
 
 	AudioSourceInstance::AudioSourceInstance()
