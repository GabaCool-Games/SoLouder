From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Sun, 18 Oct 2026 02:40:48 +0300
Subject: [PATCH] TedSid::loadFile: take the SID model from the dump's flags

The model was picked from bits 4 and 5 of mFlags, the source's own
flags (listener-relative and distance delay), instead of the flags byte
just read from the dump, so every dump played as a 6581 unless the
source had those 3D settings.
---
 src/audiosource/tedsid/soloud_tedsid.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/audiosource/tedsid/soloud_tedsid.cpp b/src/audiosource/tedsid/soloud_tedsid.cpp
index 319af0a..d2d1760 100644
--- a/src/audiosource/tedsid/soloud_tedsid.cpp
+++ b/src/audiosource/tedsid/soloud_tedsid.cpp
@@ -186,10 +186,12 @@ namespace SoLoud
 		mLooppos = aFile->read16() * 1024 + aFile->read16();
 		aFile->read32(); // cpuspeed
 		aFile->read32(); // chipspeed
-		if ((mFlags & (16 | 32)) ==  0) mModel = SID6581;
-		if ((mFlags & (16 | 32)) == 16) mModel = SID8580;
-		if ((mFlags & (16 | 32)) == 32) mModel = SID8580DB;
-		if ((mFlags & (16 | 32)) == 48) mModel = SID6581R1;
+		// The dump's flags, not the source's (mFlags, whose bits 4 and 5 are
+		// 3D settings), give the SID model.
+		if ((flags & (16 | 32)) ==  0) mModel = SID6581;
+		if ((flags & (16 | 32)) == 16) mModel = SID8580;
+		if ((flags & (16 | 32)) == 32) mModel = SID8580DB;
+		if ((flags & (16 | 32)) == 48) mModel = SID6581R1;
 		mOps = new unsigned short[mLength];
 		aFile->seek(dataofs);
 		if (flags & 1)
