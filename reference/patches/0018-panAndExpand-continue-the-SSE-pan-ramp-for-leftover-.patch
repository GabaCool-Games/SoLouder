From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Mon, 12 Oct 2026 13:34:08 +0300
Subject: [PATCH] panAndExpand: continue the SSE pan ramp for leftover frames

The SSE 1->2 and 2->2 paths multiplied the per-sample volume step by 4
for the quad loop and kept using it in the scalar loop that handles
frames left over when a mix call is not a multiple of 4 frames long.
That loop also restarted from the starting volume, so the last frames
of a volume or pan change overshot (up to 4/3 of the target for a
6-frame call). Keep the per-sample step for the leftover loop and
start it where the quad loop ended.
---
 src/core/soloud.cpp | 20 ++++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

diff --git a/src/core/soloud.cpp b/src/core/soloud.cpp
index ef9ced2..82f6182 100644
--- a/src/core/soloud.cpp
+++ b/src/core/soloud.cpp
@@ -1150,10 +1150,10 @@ namespace SoLoud
 						pan1.mData[1] = pan[1] + pani[1] * 2;
 						pan1.mData[2] = pan[1] + pani[1] * 3;
 						pan1.mData[3] = pan[1] + pani[1] * 4;
-						pani[0] *= 4;
-						pani[1] *= 4;
-						__m128 pan0delta = _mm_load_ps1(&pani[0]);
-						__m128 pan1delta = _mm_load_ps1(&pani[1]);
+						// pani stays per-sample: the leftover loop below continues the ramp.
+						float quadstep[2] = { pani[0] * 4, pani[1] * 4 };
+						__m128 pan0delta = _mm_load_ps1(&quadstep[0]);
+						__m128 pan1delta = _mm_load_ps1(&quadstep[1]);
 						__m128 p0 = _mm_load_ps(pan0.mData);
 						__m128 p1 = _mm_load_ps(pan1.mData);
 
@@ -1176,6 +1176,8 @@ namespace SoLoud
 					}
 					
 					// If buffer size or samples to read are not divisible by 4, handle leftovers
+					pan[0] += pani[0] * c;
+					pan[1] += pani[1] * c;
 					for (j = c; j < aSamplesToRead; j++)
 					{
 						pan[0] += pani[0];
@@ -1215,10 +1217,10 @@ namespace SoLoud
 						pan1.mData[1] = pan[1] + pani[1] * 2;
 						pan1.mData[2] = pan[1] + pani[1] * 3;
 						pan1.mData[3] = pan[1] + pani[1] * 4;
-						pani[0] *= 4;
-						pani[1] *= 4;
-						__m128 pan0delta = _mm_load_ps1(&pani[0]);
-						__m128 pan1delta = _mm_load_ps1(&pani[1]);
+						// pani stays per-sample: the leftover loop below continues the ramp.
+						float quadstep[2] = { pani[0] * 4, pani[1] * 4 };
+						__m128 pan0delta = _mm_load_ps1(&quadstep[0]);
+						__m128 pan1delta = _mm_load_ps1(&quadstep[1]);
 						__m128 p0 = _mm_load_ps(pan0.mData);
 						__m128 p1 = _mm_load_ps(pan1.mData);
 
@@ -1239,6 +1241,8 @@ namespace SoLoud
 						}
 					}
 					// If buffer size or samples to read are not divisible by 4, handle leftovers
+					pan[0] += pani[0] * c;
+					pan[1] += pani[1] * c;
 					for (j = c; j < aSamplesToRead; j++)
 					{
 						pan[0] += pani[0];
