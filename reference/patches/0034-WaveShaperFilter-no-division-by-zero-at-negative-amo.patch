From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Mon, 12 Oct 2026 18:10:56 +0300
Subject: [PATCH] WaveShaperFilter: no division by zero at negative amounts

---
 src/filter/soloud_waveshaperfilter.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/filter/soloud_waveshaperfilter.cpp b/src/filter/soloud_waveshaperfilter.cpp
index b9fa716..3fa70b6 100644
--- a/src/filter/soloud_waveshaperfilter.cpp
+++ b/src/filter/soloud_waveshaperfilter.cpp
@@ -51,7 +51,10 @@ namespace SoLoud
 		for (i = 0; i < aSamples; i++)
 		{
 			float dry = aBuffer[i];
-			float wet = (1 + k) * aBuffer[i] / (1 + k * (float)fabs(aBuffer[i]));
+			// With a negative amount the curve has a pole at |x| = -1 / k (at 1
+			// for amount -1, where it is 0 / 0); past it the output is 0.
+			float denominator = 1 + k * (float)fabs(aBuffer[i]);
+			float wet = denominator > 0 ? (1 + k) * aBuffer[i] / denominator : 0;
 			aBuffer[i] += (wet - dry) * mParam[WaveShaperFilter::WET];
 		}
 	}
