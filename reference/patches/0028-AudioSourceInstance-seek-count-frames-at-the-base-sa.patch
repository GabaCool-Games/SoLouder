From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:39:44 +0300
Subject: [PATCH] AudioSourceInstance::seek: count frames at the base sample
 rate

---
 src/core/soloud_audiosource.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/core/soloud_audiosource.cpp b/src/core/soloud_audiosource.cpp
index 0e7f22b..229df75 100644
--- a/src/core/soloud_audiosource.cpp
+++ b/src/core/soloud_audiosource.cpp
@@ -178,7 +178,9 @@ namespace SoLoud
 			}
 			offset = aSeconds;
 		}
-		int samples_to_discard = (int)floor(mSamplerate * offset);
+		// mStreamPosition counts seconds of source, so the relative play speed
+		// in mSamplerate does not apply.
+		int samples_to_discard = (int)floor(mBaseSamplerate * offset);
 
 		while (samples_to_discard > 0)
 		{
