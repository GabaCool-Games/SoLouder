From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V <61495413+kelo221@users.noreply.github.com>
Date: Sun, 18 Oct 2026 03:10:28 +0300
Subject: [PATCH] Ay::loadFile: decompress zx7 chunks within their bounds

As in TedSid, zx7_decompress read and wrote without bounds, so a dump's
compressed chunks could write past its ops and read past its data. Ay
now uses zx7_decompress_bounded, and a chunk that would go outside fails
the load. The unbounded zx7_decompress, now unused, is removed.
---
 include/zx7decompress.h          | 30 +-----------------------------
 src/audiosource/ay/soloud_ay.cpp | 13 +++++++++++--
 2 files changed, 12 insertions(+), 31 deletions(-)

diff --git a/include/zx7decompress.h b/include/zx7decompress.h
index 173a01e..2fb5ae9 100644
--- a/include/zx7decompress.h
+++ b/include/zx7decompress.h
@@ -23,7 +23,7 @@ struct zx7_io
     size_t output_index;
     int bit_mask;
     int bit_value;
-    /* Bounds of zx7_decompress_bounded; 0 for none. */
+    /* Bounds of zx7_decompress_bounded. */
     size_t input_length;
     size_t output_length;
     int error;
@@ -102,34 +102,6 @@ static void zx7_write_bytes(struct zx7_io *io, int offset, int length) {
     }
 }
 
-static int zx7_decompress(unsigned char *input_data, unsigned char *output_data) {
-    struct zx7_io io;
-    int length;
-
-    io.input_data = input_data;
-    io.output_data = output_data;
-    io.input_index = 0;
-    io.output_index = 0;
-    io.bit_mask = 0;
-    io.bit_value = 0;
-    io.input_length = 0;
-    io.output_length = 0;
-    io.error = 0;
-
-    zx7_write_byte(&io, zx7_read_byte(&io));
-    while (1) {
-        if (!zx7_read_bit(&io)) {
-            zx7_write_byte(&io, zx7_read_byte(&io));
-        } else {
-            length = zx7_read_elias_gamma(&io) + 1;
-            if (length == 0) {
-                return io.input_index;
-            }
-            zx7_write_bytes(&io, zx7_read_offset(&io) + 1, length);
-        }
-    }
-}
-
 /*
  * zx7_decompress within bounds: reads at most input_length bytes, writes
  * output_data from output_start up to output_length, and copies from
diff --git a/src/audiosource/ay/soloud_ay.cpp b/src/audiosource/ay/soloud_ay.cpp
index c1f68df..c0b242a 100644
--- a/src/audiosource/ay/soloud_ay.cpp
+++ b/src/audiosource/ay/soloud_ay.cpp
@@ -180,11 +180,20 @@ namespace SoLoud
 			unsigned char* buf = new unsigned char[len];
 			aFile->read(buf, len);
 			int bufofs = 0;
-			for (int i = 0; i < kchunks; i++)
+			bool ok = true;
+			for (int i = 0; i < kchunks && ok; i++)
 			{
-				bufofs += zx7_decompress(buf + bufofs, ((unsigned char*)ops) + i * 1024);
+				// Within the data read and the ops' bytes.
+				int used = zx7_decompress_bounded(buf + bufofs, len - bufofs, (unsigned char*)ops, ((length + 1) / 2) * 2, i * 1024);
+				ok = used >= 0;
+				bufofs += used;
 			}
 			delete[] buf;
+			if (!ok)
+			{
+				delete[] ops;
+				return FILE_LOAD_FAILED;
+			}
 		}
 		mOps = ops;
 		mLength = length;
