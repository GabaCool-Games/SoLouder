Subject: [PATCH] Bus::getApproximateVolume: reject channel mChannels

The bound check used > instead of >=, so channel 8 of an 8-channel bus read
one past mVisualizationChannelVolume.
---
 src/core/soloud_bus.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/core/soloud_bus.cpp b/src/core/soloud_bus.cpp
index 21e8f02..e39ed73 100644
--- a/src/core/soloud_bus.cpp
+++ b/src/core/soloud_bus.cpp
@@ -350,7 +350,7 @@ namespace SoLoud
 
 	float Bus::getApproximateVolume(unsigned int aChannel)
 	{
-		if (aChannel > mChannels)
+		if (aChannel >= mChannels)
 			return 0;
 		float vol = 0;
 		if (mInstance && mSoloud)
